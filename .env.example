# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed — see enshrly/settings.py for how these are read.

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_SECRET_KEY=
# Optional production hardening (all default sensibly off while DJANGO_DEBUG=True):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# Defaults to local SQLite if unset. For production set e.g.:
# DATABASE_URL=postgres://enshrly:PASSWORD@localhost:5432/enshrly
DATABASE_URL=

# Celery — defaults are fine when Redis is running locally. Set
# CELERY_TASK_ALWAYS_EAGER=False once a real worker + beat are running.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# Fernet key encrypting WordPressSite.application_password in the DB.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Local Baileys WhatsApp bot (payment/renewal notifications) — leave blank to simulate (logs only)
WHATSAPP_BOT_URL=http://127.0.0.1:3001

# Email (OTP delivery). Leave EMAIL_HOST blank to print OTPs to the console locally.
# Example for Gmail SMTP: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Local wallet transfer confirmation API (mobile app / worker integration)
WALLET_API_KEY=
WALLET_NUMBER=
PAIRING_TOKEN=

# PayPal — https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

# Paymob — https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_HMAC_KEY=
PAYMOB_CARD_INTEGRATION_ID=5792603
PAYMOB_IFRAME_ID=1063704

# Public base URL of this server (used for Facebook OAuth redirect_uri and
# for building public image URLs sent to the Facebook Graph API)
SITE_BASE_URL=http://localhost:8000

# Facebook app for the self-serve Page-connect OAuth flow — https://developers.facebook.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional HTTP(S) proxy for AISource rows with use_proxy=True (feeds that
# block this server's IP specifically). Standard proxy URL format:
# http://username:password@proxy-host:port
SCRAPING_PROXY_URL=

# Free alternative to SCRAPING_PROXY_URL - see cloudflare-worker/fetch-proxy.js.
# Takes priority over SCRAPING_PROXY_URL when both are set.
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_WORKER_TOKEN=
